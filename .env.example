# Copy this file to .env and fill in your real values.
# Never commit the real .env file.

# Stripe secret key (starts with sk_live_ or sk_test_) - from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Stripe Price ID for the PC Optimizer Suite product - from https://dashboard.stripe.com/products
STRIPE_PRICE_ID=

# Your live site URL (used to build Stripe success/cancel redirect links)
SITE_URL=https://veyloservices.com
